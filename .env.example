# Copie para .env e preencha com as credenciais oficiais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.

PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres
NODE_ENV=development

# ── Banco de dados relacional (Neon PostgreSQL) ──
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/DB?sslmode=require

# ── Armazenamento de mídia (Cloudinary) ──
# A API Key precisa de permissão "Read and Write" para aceitar uploads.
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=su_api_secret

# ── Origem da migração de dados (banco de produção anterior) ──
SOURCE_DATABASE_URL=
